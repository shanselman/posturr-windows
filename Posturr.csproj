<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>posturr.ico</ApplicationIcon>
    <AssemblyName>Posturr</AssemblyName>
    <Product>Posturr for Windows</Product>
    <Description>Posture monitoring app - a Windows port of Posturr by Tom Lancaster</Description>
    <Company>Scott Hanselman</Company>
    <Authors>Scott Hanselman</Authors>
    <Copyright>Copyright © 2026. Original concept by Tom Lancaster, Cam, and Ben.</Copyright>
    <RepositoryUrl>https://github.com/shanselman/posturr-windows</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

</Project>
