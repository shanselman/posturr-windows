<Window x:Class="Posturr.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posturr Calibration"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#DD000000"
        WindowState="Maximized"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Pulsing ring -->
        <Ellipse x:Name="OuterGlow" 
                 Width="150" Height="150"
                 Fill="#4400FFFF"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="RingTransform"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        
        <Ellipse x:Name="Ring" 
                 Width="100" Height="100"
                 Stroke="#00FFFF" StrokeThickness="5"
                 Fill="Transparent"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="RingTransform2"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        
        <Ellipse x:Name="CenterDot" 
                 Width="20" Height="20"
                 Fill="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="DotTransform"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        
        <!-- Step indicator at top -->
        <TextBlock x:Name="StepText"
                   Text="Step 1 of 4"
                   FontSize="20"
                   Foreground="#AAFFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,50,0,0"/>
        
        <!-- Main instruction -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="InstructionText"
                       Text="Look at the ring"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,200,0,10"/>
            
            <TextBlock Text="Move your head naturally • Press Space when ready"
                       FontSize="18"
                       Foreground="#00FFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Press Escape to skip calibration"
                       FontSize="14"
                       Foreground="#77FFFFFF"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
